/-!
# Core Definitions and Exact Schrödinger-Sylvester Fidelity for Spin-Chain Early State Exclusion

Defines literal real symmetric Jacobi matrices `jacobiMatrix`, persymmetry, general complex
return and target transition amplitudes `returnAmpComplex` and `targetAmpComplex`, proves the
exact Schrödinger differential-equation fidelity theorem `schrodinger_solution_fidelity` linking
any real Jacobi matrix with an orthonormal eigenbasis directly to `returnAmpComplex`, and defines
the canonical Hochstadt-normalized odd and even symmetric-spectrum amplitudes (`ampOdd`, `ampEven`,
`amp4`, `amp5`, `amp6`, `amp7`, `amp8`, `amp9`, `amp11`) together with the divided-difference
generating kernels `H` and `He`.
-/

@[expose] public section

open scoped BigOperators
open Finset

namespace SpectralEclipse

/-- Literal `n × n` real symmetric tridiagonal Jacobi matrix with diagonal entries `a : Fin n → ℝ`
and nearest-neighbor hopping entries `b : Fin n → ℝ` (where `b i` couples site `i` to `i + 1`). -/
def jacobiMatrix {n : ℕ} (a b : Fin n → ℝ) : Matrix (Fin n) (Fin n) ℝ :=
  Matrix.of fun i j =>
    if i = j then a i
    else if (i : ℕ) + 1 = (j : ℕ) then b i
    else if (j : ℕ) + 1 = (i : ℕ) then b j
    else 0

/-- Every `jacobiMatrix` is real symmetric (`Jᵀ = J`). -/
theorem jacobiMatrix_transpose {n : ℕ} (a b : Fin n → ℝ) :
    (jacobiMatrix a b).transpose = jacobiMatrix a b := by
  ext i j
  simp only [Matrix.transpose_apply, jacobiMatrix, Matrix.of_apply]
  by_cases h1 : j = i
  · subst h1; simp
  · have h1' : i ≠ j := Ne.symm h1
    simp only [h1, h1', ↓reduceIte]
    by_cases h2 : (j : ℕ) + 1 = (i : ℕ)
    · have h2' : ¬((i : ℕ) + 1 = (j : ℕ)) := by omega
      simp [h2, h2']
    · by_cases h3 : (i : ℕ) + 1 = (j : ℕ)
      · simp [h2, h3]
      · simp [h2, h3]

/-- Persymmetry (mirror symmetry about the anti-diagonal) of a Jacobi matrix `(a, b)`. -/
def IsPersymmetricJacobi {n : ℕ} (a b : Fin n → ℝ) : Prop :=
  (∀ i : Fin n, a (Fin.rev i) = a i) ∧
  (∀ i : Fin n, (hi : (i : ℕ) + 1 < n) →
    b ⟨n - 2 - (i : ℕ), by omega⟩ = b i)

/-- Spectral state vector `ψ(t) = ∑_k (u_k 0) e^{-i λ_k t} u_k ∈ ℂ^n` generated by real
eigenvectors `u` and eigenvalues `lam` starting from localized excitation `|0⟩`. -/
noncomputable def spectralState {n : ℕ} (lam : Fin n → ℝ) (u : Fin n → Fin n → ℝ)
    (t : ℝ) : Fin n → ℂ :=
  fun j => ∑ k : Fin n,
    ((u k ⟨0, Nat.pos_of_ne_zero (by
        intro h0; subst h0; exact Fin.elim0 j)⟩ : ℝ) : ℂ) *
      Complex.exp (-Complex.I * (lam k : ℂ) * (t : ℂ)) * (u k j : ℂ)

/-- Return amplitude `⟨e^{-iJt} e_0, e_0⟩ = ∑_k w_k e^{-i λ_k t}` in `ℂ`. -/
noncomputable def returnAmpComplex {n : ℕ} (lam w : Fin n → ℝ) (t : ℝ) : ℂ :=
  ∑ k : Fin n, (w k : ℂ) * Complex.exp (-Complex.I * (lam k : ℂ) * (t : ℂ))

/-- Target transfer amplitude `⟨e^{-iJt} e_0, e_{n-1}⟩` for a chain of length `n ≥ 1`. -/
noncomputable def targetAmpComplex {n : ℕ} (hn : 0 < n) (lam : Fin n → ℝ)
    (u : Fin n → Fin n → ℝ) (t : ℝ) : ℂ :=
  ∑ k : Fin n,
    ((u k ⟨0, hn⟩ * u k ⟨n - 1, Nat.sub_lt hn Nat.one_pos⟩ : ℝ) : ℂ) *
      Complex.exp (-Complex.I * (lam k : ℂ) * (t : ℂ))

/-- Exact Schrödinger-equation and Sylvester fidelity theorem:
Given ANY real `n × n` matrix `J` (in particular any `jacobiMatrix a b`) with a real eigenbasis
`u` and eigenvalues `lam` satisfying `J u_k = λ_k u_k` and completeness `∑_k (u_k 0) u_k = e_0`,
the complex state trajectory `ψ(t) = spectralState lam u t` satisfies:
  (1) Initial condition `ψ(0) = e_0`;
  (2) Exact time-dependent Schrödinger equation `dψ_j/dt = -i (J ψ(t))_j` for all `t ∈ ℝ`;
  (3) Return component `ψ(t)_0 = returnAmpComplex lam (fun k => (u k 0)^2) t`;
  (4) Target component `ψ(t)_{n-1} = targetAmpComplex hn lam u t`. -/
theorem schrodinger_solution_fidelity {n : ℕ} (hn : 0 < n)
    (J : Matrix (Fin n) (Fin n) ℝ) (lam : Fin n → ℝ) (u : Fin n → Fin n → ℝ)
    (heig : ∀ k : Fin n, J.mulVec (u k) = lam k • (u k))
    (hinit : ∀ j : Fin n, ∑ k : Fin n, u k ⟨0, hn⟩ * u k j = if j = ⟨0, hn⟩ then 1 else 0) :
    (∀ j : Fin n, spectralState lam u 0 j = if j = ⟨0, hn⟩ then 1 else 0) ∧
    (∀ t : ℝ, ∀ j : Fin n,
      HasDerivAt (fun s => spectralState lam u s j)
        (-Complex.I * ((J.map Complex.ofReal).mulVec (spectralState lam u t) j)) t) ∧
    (∀ t : ℝ, spectralState lam u t ⟨0, hn⟩ =
      returnAmpComplex lam (fun k => (u k ⟨0, hn⟩) ^ 2) t) ∧
    (∀ t : ℝ, spectralState lam u t ⟨n - 1, Nat.sub_lt hn Nat.one_pos⟩ =
      targetAmpComplex hn lam u t) := by
  refine ⟨?_, ?_, ?_, ?_⟩
  · intro j
    simp only [spectralState, Complex.ofReal_zero, mul_zero, Complex.exp_zero, mul_one]
    have h := congrArg (Complex.ofReal) (hinit j)
    push_cast at h
    have hsum : ∑ k : Fin n,
        (u k ⟨0, Nat.pos_of_ne_zero (by intro h0; subst h0; exact Fin.elim0 j)⟩ : ℂ) * (u k j : ℂ) =
        ∑ k : Fin n, (u k ⟨0, hn⟩ : ℂ) * (u k j : ℂ) := by
      refine Finset.sum_congr rfl fun k _ => rfl
    rw [hsum, h]
    split_ifs <;> simp
  · intro t j
    have hterm : ∀ k : Fin n,
        HasDerivAt
          (fun s : ℝ =>
            ((u k ⟨0, hn⟩ : ℝ) : ℂ) *
              Complex.exp (-Complex.I * (lam k : ℂ) * (s : ℂ)) * (u k j : ℂ))
          (-Complex.I * (lam k : ℂ) *
            (((u k ⟨0, hn⟩ : ℝ) : ℂ) *
              Complex.exp (-Complex.I * (lam k : ℂ) * (t : ℂ)) * (u k j : ℂ))) t := by
      intro k
      have hreal : HasDerivAt (fun s : ℝ => (s : ℂ)) (1 : ℂ) t := by
        simpa using (hasDerivAt_id t).ofReal_comp
      have hlin : HasDerivAt (fun s : ℝ => (-Complex.I * (lam k : ℂ)) * (s : ℂ))
          (-Complex.I * (lam k : ℂ)) t := by
        simpa using hreal.const_mul (-Complex.I * (lam k : ℂ))
      have hexp := hlin.cexp
      have h1 := hexp.const_mul ((u k ⟨0, hn⟩ : ℝ) : ℂ)
      have h2 := h1.mul_const ((u k j : ℝ) : ℂ)
      convert h2 using 1
      ring
    have hsum := HasDerivAt.fun_sum (u := Finset.univ) (fun k _ => hterm k)
    have heq_fun : (fun s : ℝ => spectralState lam u s j) =
        fun s : ℝ => ∑ k : Fin n,
          ((u k ⟨0, hn⟩ : ℝ) : ℂ) *
            Complex.exp (-Complex.I * (lam k : ℂ) * (s : ℂ)) * (u k j : ℂ) := by
      funext s
      simp only [spectralState]
    rw [heq_fun]
    refine hsum.congr_deriv ?_
    symm
    change -Complex.I * ∑ l : Fin n, (J j l : ℂ) *
        ∑ k : Fin n,
          (u k ⟨0, Nat.pos_of_ne_zero (by intro h0; subst h0; exact Fin.elim0 l)⟩ : ℂ) *
            Complex.exp (-Complex.I * (lam k : ℂ) * (t : ℂ)) * (u k l : ℂ) =
      ∑ k : Fin n, -Complex.I * (lam k : ℂ) *
        ((u k ⟨0, hn⟩ : ℂ) * Complex.exp (-Complex.I * (lam k : ℂ) * (t : ℂ)) * (u k j : ℂ))
    have heig_c : ∀ k : Fin n,
        ∑ l : Fin n, (J j l : ℂ) * (u k l : ℂ) = (lam k : ℂ) * (u k j : ℂ) := by
      intro k
      have hk := congrArg (fun v => (v j : ℂ)) (heig k)
      simp only [Matrix.mulVec, dotProduct, Pi.smul_apply, smul_eq_mul] at hk
      push_cast at hk
      exact hk
    calc
      -Complex.I * ∑ l : Fin n, (J j l : ℂ) *
          ∑ k : Fin n, (u k ⟨0, Nat.pos_of_ne_zero (by intro h0; subst h0; exact Fin.elim0 l)⟩ : ℂ) *
            Complex.exp (-Complex.I * (lam k : ℂ) * (t : ℂ)) * (u k l : ℂ)
          = -Complex.I * ∑ k : Fin n,
              ((u k ⟨0, hn⟩ : ℂ) * Complex.exp (-Complex.I * (lam k : ℂ) * (t : ℂ))) *
                (∑ l : Fin n, (J j l : ℂ) * (u k l : ℂ)) := by
            congr 1
            simp_rw [Finset.mul_sum]
            rw [Finset.sum_comm]
            refine Finset.sum_congr rfl fun k _ => ?_
            refine Finset.sum_congr rfl fun l _ => ?_
            ring
      _ = ∑ k : Fin n, -Complex.I * (lam k : ℂ) *
            ((u k ⟨0, hn⟩ : ℂ) * Complex.exp (-Complex.I * (lam k : ℂ) * (t : ℂ)) * (u k j : ℂ)) := by
            rw [Finset.mul_sum]
            refine Finset.sum_congr rfl fun k _ => ?_
            rw [heig_c k]
            ring
  · intro t
    simp only [spectralState, returnAmpComplex]
    refine Finset.sum_congr rfl fun k _ => ?_
    push_cast
    ring
  · intro t
    simp only [spectralState, targetAmpComplex]
    refine Finset.sum_congr rfl fun k _ => ?_
    push_cast
    ring

/-- Early State Exclusion (ESE) predicate for a real-valued return amplitude on `(0, π)`. -/
def HasESEReal (A : ℝ → ℝ) : Prop :=
  ∃ τ : ℝ, 0 < τ ∧ τ < Real.pi ∧ A τ = 0

/-- Early State Exclusion (ESE) predicate for a general complex-valued return amplitude on `(0, T)`. -/
def HasESEComplex (A : ℝ → ℂ) (T : ℝ) : Prop :=
  ∃ τ : ℝ, 0 < τ ∧ τ < T ∧ A τ = 0

/-! ### Generating Kernels `H` (odd chains) and `He` (even chains) -/

/-- Divided-difference generating function for odd symmetric PST chains:
`H(w) = (1 - cos(2√w)) / (2w) = sinc²(√w)` for `w > 0`, and `H(0) = 1`. -/
noncomputable def H (w : ℝ) : ℝ :=
  if w = 0 then 1 else (1 - Real.cos (2 * Real.sqrt w)) / (2 * w)

/-- Divided-difference generating function for even symmetric PST chains (0th spherical Bessel):
`He(w) = sin(√w) / √w` for `w > 0`, and `He(0) = 1`. -/
noncomputable def He (w : ℝ) : ℝ :=
  if w = 0 then 1 else Real.sin (Real.sqrt w) / Real.sqrt w

/-- For `x > 0`, `H(x²) = (sin x / x)²`. -/
theorem H_sq {x : ℝ} (hx : 0 < x) : H (x ^ 2) = (Real.sin x / x) ^ 2 := by
  have hx2 : x ^ 2 ≠ 0 := pow_ne_zero 2 hx.ne'
  simp only [H, hx2, ↓reduceIte, Real.sqrt_sq hx.le]
  have hcos : 1 - Real.cos (2 * x) = 2 * Real.sin x ^ 2 := by
    rw [Real.cos_two_mul]
    have := Real.sin_sq_add_cos_sq x
    linarith
  rw [hcos]
  field_simp [hx.ne']

/-- For `x > 0`, `He(x²) = sin x / x`. -/
theorem He_sq {x : ℝ} (hx : 0 < x) : He (x ^ 2) = Real.sin x / x := by
  have hx2 : x ^ 2 ≠ 0 := pow_ne_zero 2 hx.ne'
  simp only [He, hx2, ↓reduceIte, Real.sqrt_sq hx.le]

/-! ### Hochstadt-Normalized Return Amplitudes for Symmetric PST Chains -/

/-- Unnormalized Hochstadt weight for the zero eigenvalue of an odd `(2n+1) × (2n+1)` symmetric
spectrum `{0, ±lam 0, ..., ±lam (n-1)}`: `W_0 = (∏_i lam_i²)⁻¹`. -/
noncomputable def hochstadtWeightOdd0 {n : ℕ} (lam : Fin n → ℝ) : ℝ :=
  (∏ i : Fin n, (lam i) ^ 2)⁻¹

/-- Unnormalized Hochstadt weight for the `±lam k` pair of an odd `(2n+1) × (2n+1)` symmetric
spectrum `{0, ±lam 0, ..., ±lam (n-1)}`: `W_{k+1} = (lam_k² ∏_{i≠k} |lam_k² - lam_i²|)⁻¹`. -/
noncomputable def hochstadtWeightOdd {n : ℕ} (lam : Fin n → ℝ) (k : Fin n) : ℝ :=
  ((lam k) ^ 2 * ∏ i ∈ Finset.univ.erase k, |(lam k) ^ 2 - (lam i) ^ 2|)⁻¹

/-- Normalized return amplitude for a general odd `(2n+1) × (2n+1)` symmetric PST chain. -/
noncomputable def ampOdd {n : ℕ} (lam : Fin n → ℝ) (t : ℝ) : ℝ :=
  (hochstadtWeightOdd0 lam + ∑ k : Fin n, hochstadtWeightOdd lam k * Real.cos (lam k * t)) /
    (hochstadtWeightOdd0 lam + ∑ k : Fin n, hochstadtWeightOdd lam k)

/-- General unnormalized Hochstadt weight for even `(2n) × (2n)` symmetric spectrum
`{±p_0/2, ..., ±p_{n-1}/2}`: `W̃_k = 1 / (p_k ∏_{i≠k} |p_k² - p_i²|)`. -/
noncomputable def hochstadtWeightEven {n : ℕ} (p : Fin n → ℝ) (k : Fin n) : ℝ :=
  (p k * ∏ i ∈ Finset.univ.erase k, |(p k) ^ 2 - (p i) ^ 2|)⁻¹

/-- Normalized return amplitude for a general even `(2n) × (2n)` symmetric PST chain. -/
noncomputable def ampEven {n : ℕ} (p : Fin n → ℝ) (t : ℝ) : ℝ :=
  (∑ k : Fin n, hochstadtWeightEven p k * Real.cos (p k * t / 2)) /
    (∑ k : Fin n, hochstadtWeightEven p k)

/-- Closed-form normalized return amplitude for `4 × 4` symmetric PST chain `{±p/2, ±q/2}` (`0 < p < q`). -/
noncomputable def amp4 (p q t : ℝ) : ℝ :=
  (q * Real.cos (p * t / 2) + p * Real.cos (q * t / 2)) / (p + q)

/-- Closed-form normalized return amplitude for `5 × 5` symmetric PST chain `{0, ±y, ±x}` (`0 < y < x`). -/
noncomputable def amp5 (y x t : ℝ) : ℝ :=
  let w0 := 1 / (y ^ 2 * x ^ 2)
  let w1 := 1 / (y ^ 2 * (x ^ 2 - y ^ 2))
  let w2 := 1 / (x ^ 2 * (x ^ 2 - y ^ 2))
  (w0 + w1 * Real.cos (y * t) + w2 * Real.cos (x * t)) / (w0 + w1 + w2)

/-- Closed-form normalized return amplitude for `6 × 6` symmetric PST chain `{±p/2, ±q/2, ±r/2}` (`0 < p < q < r`). -/
noncomputable def amp6 (p q r t : ℝ) : ℝ :=
  let w1 := 1 / (p * (q ^ 2 - p ^ 2) * (r ^ 2 - p ^ 2))
  let w2 := 1 / (q * (q ^ 2 - p ^ 2) * (r ^ 2 - q ^ 2))
  let w3 := 1 / (r * (r ^ 2 - p ^ 2) * (r ^ 2 - q ^ 2))
  (w1 * Real.cos (p * t / 2) + w2 * Real.cos (q * t / 2) + w3 * Real.cos (r * t / 2)) /
    (w1 + w2 + w3)

/-- Closed-form normalized return amplitude for `7 × 7` symmetric PST chain `{0, ±x, ±y, ±z}` (`0 < x < y < z`). -/
noncomputable def amp7 (x y z t : ℝ) : ℝ :=
  let w0 := 1 / (x ^ 2 * y ^ 2 * z ^ 2)
  let w1 := 1 / (x ^ 2 * (y ^ 2 - x ^ 2) * (z ^ 2 - x ^ 2))
  let w2 := 1 / (y ^ 2 * (y ^ 2 - x ^ 2) * (z ^ 2 - y ^ 2))
  let w3 := 1 / (z ^ 2 * (z ^ 2 - x ^ 2) * (z ^ 2 - y ^ 2))
  (w0 + w1 * Real.cos (x * t) + w2 * Real.cos (y * t) + w3 * Real.cos (z * t)) /
    (w0 + w1 + w2 + w3)

/-- Closed-form normalized return amplitude for `8 × 8` symmetric PST chain `{±p₁/2, ±p₂/2, ±p₃/2, ±p₄/2}`. -/
noncomputable def amp8 (p1 p2 p3 p4 t : ℝ) : ℝ :=
  let w1 := 1 / (p1 * (p2 ^ 2 - p1 ^ 2) * (p3 ^ 2 - p1 ^ 2) * (p4 ^ 2 - p1 ^ 2))
  let w2 := 1 / (p2 * (p2 ^ 2 - p1 ^ 2) * (p3 ^ 2 - p2 ^ 2) * (p4 ^ 2 - p2 ^ 2))
  let w3 := 1 / (p3 * (p3 ^ 2 - p1 ^ 2) * (p3 ^ 2 - p2 ^ 2) * (p4 ^ 2 - p3 ^ 2))
  let w4 := 1 / (p4 * (p4 ^ 2 - p1 ^ 2) * (p4 ^ 2 - p2 ^ 2) * (p4 ^ 2 - p3 ^ 2))
  (w1 * Real.cos (p1 * t / 2) + w2 * Real.cos (p2 * t / 2) +
    w3 * Real.cos (p3 * t / 2) + w4 * Real.cos (p4 * t / 2)) / (w1 + w2 + w3 + w4)

/-- Closed-form normalized return amplitude for `9 × 9` symmetric PST chain `{0, ±a, ±b, ±c, ±d}`. -/
noncomputable def amp9 (a b c d t : ℝ) : ℝ :=
  let w0 := 1 / (a ^ 2 * b ^ 2 * c ^ 2 * d ^ 2)
  let w1 := 1 / (a ^ 2 * (b ^ 2 - a ^ 2) * (c ^ 2 - a ^ 2) * (d ^ 2 - a ^ 2))
  let w2 := 1 / (b ^ 2 * (b ^ 2 - a ^ 2) * (c ^ 2 - b ^ 2) * (d ^ 2 - b ^ 2))
  let w3 := 1 / (c ^ 2 * (c ^ 2 - a ^ 2) * (c ^ 2 - b ^ 2) * (d ^ 2 - c ^ 2))
  let w4 := 1 / (d ^ 2 * (d ^ 2 - a ^ 2) * (d ^ 2 - b ^ 2) * (d ^ 2 - c ^ 2))
  (w0 + w1 * Real.cos (a * t) + w2 * Real.cos (b * t) +
    w3 * Real.cos (c * t) + w4 * Real.cos (d * t)) / (w0 + w1 + w2 + w3 + w4)

/-- Closed-form normalized return amplitude for `11 × 11` symmetric PST chain `{0, ±l₁, ±l₂, ±l₃, ±l₄, ±l₅}`. -/
noncomputable def amp11 (l1 l2 l3 l4 l5 t : ℝ) : ℝ :=
  let w0 := 1 / (l1 ^ 2 * l2 ^ 2 * l3 ^ 2 * l4 ^ 2 * l5 ^ 2)
  let w1 := 1 / (l1 ^ 2 * (l2 ^ 2 - l1 ^ 2) * (l3 ^ 2 - l1 ^ 2) * (l4 ^ 2 - l1 ^ 2) * (l5 ^ 2 - l1 ^ 2))
  let w2 := 1 / (l2 ^ 2 * (l2 ^ 2 - l1 ^ 2) * (l3 ^ 2 - l2 ^ 2) * (l4 ^ 2 - l2 ^ 2) * (l5 ^ 2 - l2 ^ 2))
  let w3 := 1 / (l3 ^ 2 * (l3 ^ 2 - l1 ^ 2) * (l3 ^ 2 - l2 ^ 2) * (l4 ^ 2 - l3 ^ 2) * (l5 ^ 2 - l3 ^ 2))
  let w4 := 1 / (l4 ^ 2 * (l4 ^ 2 - l1 ^ 2) * (l4 ^ 2 - l2 ^ 2) * (l4 ^ 2 - l3 ^ 2) * (l5 ^ 2 - l4 ^ 2))
  let w5 := 1 / (l5 ^ 2 * (l5 ^ 2 - l1 ^ 2) * (l5 ^ 2 - l2 ^ 2) * (l5 ^ 2 - l3 ^ 2) * (l5 ^ 2 - l4 ^ 2))
  (w0 + w1 * Real.cos (l1 * t) + w2 * Real.cos (l2 * t) + w3 * Real.cos (l3 * t) +
    w4 * Real.cos (l4 * t) + w5 * Real.cos (l5 * t)) / (w0 + w1 + w2 + w3 + w4 + w5)

/-- Explicit consistency between `ampEven` at `n = 2` and `amp4`. -/
theorem ampEven_two_eq_amp4 {p q : ℝ} (hp : 0 < p) (hpq : p < q) (t : ℝ) :
    ampEven ![p, q] t = amp4 p q t := by
  have hqp : 0 < q ^ 2 - p ^ 2 := by nlinarith
  have hpq_ne : p + q ≠ 0 := by linarith
  have hq : 0 < q := by linarith
  simp only [ampEven, hochstadtWeightEven, amp4, Fin.sum_univ_two, Matrix.cons_val_zero,
    Matrix.cons_val_one]
  have h0 : Finset.univ.erase (0 : Fin 2) = {1} := by decide
  have h1 : Finset.univ.erase (1 : Fin 2) = {0} := by decide
  rw [h0, h1]
  simp only [Finset.prod_singleton, Matrix.cons_val_zero, Matrix.cons_val_one]
  rw [abs_of_neg (by linarith : p ^ 2 - q ^ 2 < 0), abs_of_pos hqp]
  have hneg : -(p ^ 2 - q ^ 2) = q ^ 2 - p ^ 2 := by ring
  rw [hneg]
  field_simp [hp.ne', hq.ne', hqp.ne', hpq_ne]
  ring

/-- Explicit consistency between `ampOdd` at `n = 2` and `amp5`. -/
theorem ampOdd_two_eq_amp5 {y x : ℝ} (hy : 0 < y) (hyx : y < x) (t : ℝ) :
    ampOdd ![y, x] t = amp5 y x t := by
  have hxy : 0 < x ^ 2 - y ^ 2 := by nlinarith
  simp only [ampOdd, hochstadtWeightOdd0, hochstadtWeightOdd, amp5, Fin.sum_univ_two,
    Fin.prod_univ_two, Matrix.cons_val_zero, Matrix.cons_val_one]
  have h0 : Finset.univ.erase (0 : Fin 2) = {1} := by decide
  have h1 : Finset.univ.erase (1 : Fin 2) = {0} := by decide
  rw [h0, h1]
  simp only [Finset.prod_singleton, Matrix.cons_val_zero, Matrix.cons_val_one]
  rw [abs_of_neg (by linarith : y ^ 2 - x ^ 2 < 0), abs_of_pos hxy]
  have hneg : -(y ^ 2 - x ^ 2) = x ^ 2 - y ^ 2 := by ring
  rw [hneg]
  simp only [one_div]
  ring

/-- Explicit consistency between `ampEven` at `n = 3` and `amp6`. -/
theorem ampEven_three_eq_amp6 {p q r : ℝ} (hp : 0 < p) (hpq : p < q) (hqr : q < r) (t : ℝ) :
    ampEven ![p, q, r] t = amp6 p q r t := by
  have hqp : 0 < q ^ 2 - p ^ 2 := by nlinarith
  have hrp : 0 < r ^ 2 - p ^ 2 := by nlinarith
  have hrq : 0 < r ^ 2 - q ^ 2 := by nlinarith
  simp only [ampEven, hochstadtWeightEven, amp6, Fin.sum_univ_three]
  have h0 : Finset.univ.erase (0 : Fin 3) = {1, 2} := by decide
  have h1 : Finset.univ.erase (1 : Fin 3) = {0, 2} := by decide
  have h2 : Finset.univ.erase (2 : Fin 3) = {0, 1} := by decide
  rw [h0, h1, h2]
  simp only [Finset.prod_pair (by decide : (1 : Fin 3) ≠ 2),
    Finset.prod_pair (by decide : (0 : Fin 3) ≠ 2),
    Finset.prod_pair (by decide : (0 : Fin 3) ≠ 1),
    Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.cons_val_two,
    Matrix.head_cons, Matrix.tail_cons]
  rw [abs_of_neg (by linarith : p ^ 2 - q ^ 2 < 0),
      abs_of_neg (by linarith : p ^ 2 - r ^ 2 < 0),
      abs_of_pos hqp,
      abs_of_neg (by linarith : q ^ 2 - r ^ 2 < 0),
      abs_of_pos hrp, abs_of_pos hrq]
  have hn1 : -(p ^ 2 - q ^ 2) = q ^ 2 - p ^ 2 := by ring
  have hn2 : -(p ^ 2 - r ^ 2) = r ^ 2 - p ^ 2 := by ring
  have hn3 : -(q ^ 2 - r ^ 2) = r ^ 2 - q ^ 2 := by ring
  rw [hn1, hn2, hn3]
  simp only [one_div, mul_assoc]

/-- Explicit consistency between `ampOdd` at `n = 3` and `amp7`. -/
theorem ampOdd_three_eq_amp7 {x y z : ℝ} (hx : 0 < x) (hxy : x < y) (hyz : y < z) (t : ℝ) :
    ampOdd ![x, y, z] t = amp7 x y z t := by
  have hyx : 0 < y ^ 2 - x ^ 2 := by nlinarith
  have hzx : 0 < z ^ 2 - x ^ 2 := by nlinarith
  have hzy : 0 < z ^ 2 - y ^ 2 := by nlinarith
  simp only [ampOdd, hochstadtWeightOdd0, hochstadtWeightOdd, amp7, Fin.sum_univ_three,
    Fin.prod_univ_three]
  have h0 : Finset.univ.erase (0 : Fin 3) = {1, 2} := by decide
  have h1 : Finset.univ.erase (1 : Fin 3) = {0, 2} := by decide
  have h2 : Finset.univ.erase (2 : Fin 3) = {0, 1} := by decide
  rw [h0, h1, h2]
  simp only [Finset.prod_pair (by decide : (1 : Fin 3) ≠ 2),
    Finset.prod_pair (by decide : (0 : Fin 3) ≠ 2),
    Finset.prod_pair (by decide : (0 : Fin 3) ≠ 1),
    Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.cons_val_two,
    Matrix.head_cons, Matrix.tail_cons]
  rw [abs_of_neg (by linarith : x ^ 2 - y ^ 2 < 0),
      abs_of_neg (by linarith : x ^ 2 - z ^ 2 < 0),
      abs_of_pos hyx,
      abs_of_neg (by linarith : y ^ 2 - z ^ 2 < 0),
      abs_of_pos hzx, abs_of_pos hzy]
  have hn1 : -(x ^ 2 - y ^ 2) = y ^ 2 - x ^ 2 := by ring
  have hn2 : -(x ^ 2 - z ^ 2) = z ^ 2 - x ^ 2 := by ring
  have hn3 : -(y ^ 2 - z ^ 2) = z ^ 2 - y ^ 2 := by ring
  rw [hn1, hn2, hn3]
  simp only [one_div, mul_assoc]
  ring

end SpectralEclipse
