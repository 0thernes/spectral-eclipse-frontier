/-- Bivariate Bernstein certificate for box `cert_Z0_Z1`. -/
theorem cert_Z0_Z1 {x1 x : ℝ}
    (hx1_lo : (17 / 5 : ℝ) ≤ x1) (hx1_hi : x1 ≤ (183 / 50 : ℝ))
    (hx_lo : (83 / 20 : ℝ) ≤ x) (hx_hi : x ≤ (261 / 50 : ℝ)) :
    x ^ 4 * ((7 / 20) * phi2 x1 x1 (183 / 50)) < (33 / 100) * (x ^ 2 - x1 ^ 2) ^ 2 := by
  have hx1_pos : (0 : ℝ) < x1 := by linarith
  have hx_pos : (0 : ℝ) < x := by linarith
  have hu1 : 0 ≤ (x1 - (17 / 5)) / ((13 / 50)) := div_nonneg (by linarith) (by norm_num)
  have hv1 : 0 ≤ ((183 / 50) - x1) / ((13 / 50)) := div_nonneg (by linarith) (by norm_num)
  have h1 : (x1 - (17 / 5)) / ((13 / 50)) + ((183 / 50) - x1) / ((13 / 50)) = 1 := by ring
  have hu2 : 0 ≤ (x - (83 / 20)) / ((107 / 100)) := div_nonneg (by linarith) (by norm_num)
  have hv2 : 0 ≤ ((261 / 50) - x) / ((107 / 100)) := div_nonneg (by linarith) (by norm_num)
  have h2 : (x - (83 / 20)) / ((107 / 100)) + ((261 / 50) - x) / ((107 / 100)) = 1 := by ring
  have hp := cert_Z0_Z1_pos hu1 hv1 h1 hu2 hv2 h2
  have hx1_eq : (17 / 5) * (((183 / 50) - x1) / ((13 / 50))) +
      (183 / 50) * ((x1 - (17 / 5)) / ((13 / 50))) = x1 := by ring
  have hx_eq : (83 / 20) * (((261 / 50) - x) / ((107 / 100))) +
      (261 / 50) * ((x - (83 / 20)) / ((107 / 100))) = x := by ring
  rw [hx1_eq, hx_eq, h1, h2] at hp
  have hpoly_pos : 0 < (-42899409) * x ^ 4 + (22772520) * x1 * x ^ 4 + (3202500) * x1 ^ 2 * x ^ 4 + (-22102740) * x1 ^ 3 * x ^ 2 + (-875000) * x1 ^ 3 * x ^ 4 + (11051370) * x1 ^ 5 := by
    convert hp using 1; ring
  have hK : (0 : ℝ) < (33489000) * x1 ^ 1 * x ^ 0 := by positivity
  have hclear : (33489000) * x1 ^ 1 * x ^ 0 *
      ((33 / 100) * (x ^ 2 - x1 ^ 2) ^ 2 - x ^ 4 * ((7 / 20) * phi2 x1 x1 (183 / 50))) = (-42899409) * x ^ 4 + (22772520) * x1 * x ^ 4 + (3202500) * x1 ^ 2 * x ^ 4 + (-22102740) * x1 ^ 3 * x ^ 2 + (-875000) * x1 ^ 3 * x ^ 4 + (11051370) * x1 ^ 5 := by
