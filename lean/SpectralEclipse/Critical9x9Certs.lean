/-!
# Exact Bivariate Bernstein & Barycentric Positivity Certificates for Theorem 6 (`9 × 9`)

Exact rational polynomial positivity certificates closing Case 1 and all 19 compact `PURE_B`
regions of Case 2 in `SpectralEclipse/Critical9x9.lean`. Every identity is verified directly
by Lean's kernel via atomic-variable `ring` and `positivity`.
-/

@[expose] public section

namespace SpectralEclipse

/-- Exact rational upper bound for `∫_{a²}^{b²} (v - x₁²) / v² dv` using `log(b²/a²) ≤ (b² - a²)/(ab)`. -/
noncomputable def phi2 (x1 a b : ℝ) : ℝ :=
  (b ^ 2 - a ^ 2) * (a * b - x1 ^ 2) / (a ^ 2 * b ^ 2)

/-- Exact algebraic value of `∫_{a²}^{b²} (v - x₁²) / v³ dv`. -/
noncomputable def phi3 (x1 a b : ℝ) : ℝ :=
  (b ^ 2 - a ^ 2) * (2 * a ^ 2 * b ^ 2 - x1 ^ 2 * (a ^ 2 + b ^ 2)) / (2 * a ^ 4 * b ^ 4)

private theorem pow_add_pow_pos {u v : ℝ} (hu : 0 ≤ u) (hv : 0 ≤ v) (h : 0 < u + v) (n : ℕ) :
    0 < u ^ n + v ^ n := by
  rcases eq_or_lt_of_le hu with rfl | hu'
  · rw [zero_add] at h; positivity
  · positivity

private theorem bernstein_box_touch_pos {u1 v1 u2 v2 : ℝ} (d1 d2 : ℕ)
    (hu1 : 0 ≤ u1) (hv1 : 0 ≤ v1) (h1 : 0 < u1 + v1)
    (hu2 : 0 ≤ u2) (hv2 : 0 ≤ v2) (h2 : 0 < u2 + v2)
    (htouch : 0 < v1 + u2)
    {c00 c01 c11 rest : ℝ}
    (hc00 : 0 < c00) (hc01 : 0 < c01) (hc11 : 0 < c11)
    (hrest : 0 ≤ rest) :
    0 < c00 * (v1 ^ d1 * v2 ^ d2) + c01 * (v1 ^ d1 * u2 ^ d2) +
        c11 * (u1 ^ d1 * u2 ^ d2) + rest := by
  rcases eq_or_lt_of_le hv1 with rfl | hv1'
  · have hu1' : 0 < u1 := by linarith
    have hu2' : 0 < u2 := by linarith
    have hterm : 0 < c11 * (u1 ^ d1 * u2 ^ d2) := by positivity
    have h0 : 0 ≤ c00 * ((0 : ℝ) ^ d1 * v2 ^ d2) + c01 * ((0 : ℝ) ^ d1 * u2 ^ d2) + rest := by positivity
    linarith
  · have hp2 := pow_add_pow_pos hu2 hv2 h2 d2
    have hprod : 0 < v1 ^ d1 * (u2 ^ d2 + v2 ^ d2) := mul_pos (pow_pos hv1' d1) hp2
    set cm := min c00 c01
    have hcm : 0 < cm := lt_min hc00 hc01
    have hlow : cm * (v1 ^ d1 * (u2 ^ d2 + v2 ^ d2)) ≤
        c00 * (v1 ^ d1 * v2 ^ d2) + c01 * (v1 ^ d1 * u2 ^ d2) := by
      have hsplit : cm * (v1 ^ d1 * (u2 ^ d2 + v2 ^ d2)) =
          cm * (v1 ^ d1 * v2 ^ d2) + cm * (v1 ^ d1 * u2 ^ d2) := by ring
      rw [hsplit]
      have t1 : cm * (v1 ^ d1 * v2 ^ d2) ≤ c00 * (v1 ^ d1 * v2 ^ d2) :=
        mul_le_mul_of_nonneg_right (min_le_left _ _) (by positivity)
      have t2 : cm * (v1 ^ d1 * u2 ^ d2) ≤ c01 * (v1 ^ d1 * u2 ^ d2) :=
        mul_le_mul_of_nonneg_right (min_le_right _ _) (by positivity)
      linarith
    have hpos : 0 < cm * (v1 ^ d1 * (u2 ^ d2 + v2 ^ d2)) := mul_pos hcm hprod
    have h3 : 0 ≤ c11 * (u1 ^ d1 * u2 ^ d2) + rest := by positivity
    linarith

private theorem bernstein_box_pos {u1 v1 u2 v2 : ℝ} (d1 d2 : ℕ)
    (hu1 : 0 ≤ u1) (hv1 : 0 ≤ v1) (h1 : 0 < u1 + v1)
    (hu2 : 0 ≤ u2) (hv2 : 0 ≤ v2) (h2 : 0 < u2 + v2)
    {c00 c01 c10 c11 rest : ℝ}
    (hc00 : 0 < c00) (hc01 : 0 < c01) (hc10 : 0 < c10) (hc11 : 0 < c11)
    (hrest : 0 ≤ rest) :
    0 < c00 * (v1 ^ d1 * v2 ^ d2) + c01 * (v1 ^ d1 * u2 ^ d2) +
        c10 * (u1 ^ d1 * v2 ^ d2) + c11 * (u1 ^ d1 * u2 ^ d2) + rest := by
  have hp1 := pow_add_pow_pos hu1 hv1 h1 d1
  have hp2 := pow_add_pow_pos hu2 hv2 h2 d2
  have hprod : 0 < (u1 ^ d1 + v1 ^ d1) * (u2 ^ d2 + v2 ^ d2) := mul_pos hp1 hp2
  set cm := min (min c00 c01) (min c10 c11)
  have hcm : 0 < cm := lt_min (lt_min hc00 hc01) (lt_min hc10 hc11)
  have h1' : cm ≤ c00 := le_trans (min_le_left _ _) (min_le_left _ _)
  have h2' : cm ≤ c01 := le_trans (min_le_left _ _) (min_le_right _ _)
  have h3' : cm ≤ c10 := le_trans (min_le_right _ _) (min_le_left _ _)
  have h4' : cm ≤ c11 := le_trans (min_le_right _ _) (min_le_right _ _)
  have hlow : cm * ((u1 ^ d1 + v1 ^ d1) * (u2 ^ d2 + v2 ^ d2)) ≤
      c00 * (v1 ^ d1 * v2 ^ d2) + c01 * (v1 ^ d1 * u2 ^ d2) +
      c10 * (u1 ^ d1 * v2 ^ d2) + c11 * (u1 ^ d1 * u2 ^ d2) := by
    have hsplit : cm * ((u1 ^ d1 + v1 ^ d1) * (u2 ^ d2 + v2 ^ d2)) =
        cm * (v1 ^ d1 * v2 ^ d2) + cm * (v1 ^ d1 * u2 ^ d2) +
        cm * (u1 ^ d1 * v2 ^ d2) + cm * (u1 ^ d1 * u2 ^ d2) := by ring
    rw [hsplit]
    have t1 : cm * (v1 ^ d1 * v2 ^ d2) ≤ c00 * (v1 ^ d1 * v2 ^ d2) :=
      mul_le_mul_of_nonneg_right h1' (by positivity)
    have t2 : cm * (v1 ^ d1 * u2 ^ d2) ≤ c01 * (v1 ^ d1 * u2 ^ d2) :=
      mul_le_mul_of_nonneg_right h2' (by positivity)
    have t3 : cm * (u1 ^ d1 * v2 ^ d2) ≤ c10 * (u1 ^ d1 * v2 ^ d2) :=
      mul_le_mul_of_nonneg_right h3' (by positivity)
    have t4 : cm * (u1 ^ d1 * u2 ^ d2) ≤ c11 * (u1 ^ d1 * u2 ^ d2) :=
      mul_le_mul_of_nonneg_right h4' (by positivity)
    linarith
  have hcm_prod : 0 < cm * ((u1 ^ d1 + v1 ^ d1) * (u2 ^ d2 + v2 ^ d2)) := mul_pos hcm hprod
  linarith

private theorem pos_of_mul_pos {K E : ℝ} (hK : 0 < K) (hKE : 0 < K * E) : 0 < E := by
  by_contra hle; push Not at hle
  have := mul_nonpos_of_nonneg_of_nonpos hK.le hle
  linarith only [hKE, this]

private theorem add_nonneg4 {a b c d : ℝ} (ha : 0 ≤ a) (hb : 0 ≤ b) (hc : 0 ≤ c) (hd : 0 ≤ d) :
    0 ≤ a + b + c + d := by linarith only [ha, hb, hc, hd]

private theorem add_nonneg3 {a b c : ℝ} (ha : 0 ≤ a) (hb : 0 ≤ b) (hc : 0 ≤ c) :
    0 ≤ a + b + c := by linarith only [ha, hb, hc]

private theorem add_nonneg2 {a b : ℝ} (ha : 0 ≤ a) (hb : 0 ≤ b) :
    0 ≤ a + b := by linarith only [ha, hb]

/-- Case 1 single-interval degree-6 Bernstein positivity certificate on `a ∈ (0, 25/4]`. -/
theorem cert_case1_bernstein {a : ℝ} (ha0 : 0 < a) (ha1 : a ≤ 25 / 4) :
    0 < (6889 / 400 - a) * (((1 / 3) * a ^ 0 + (-4 / 45) * a ^ 1 + (1 / 105) * a ^ 2 + (-8 / 14175) * a ^ 3 + (2 / 93555) * a ^ 4 + (-8 / 14189175) * a ^ 5) - 1 / 140) - 2 * (1 * a ^ 0 + (-1 / 3) * a ^ 1 + (2 / 45) * a ^ 2 + (-1 / 315) * a ^ 3 + (2 / 14175) * a ^ 4) := by
  have hb0 : 0 ≤ (25 / 4 : ℝ) - a := by linarith
  have hW6 : (0 : ℝ) < (25 / 4 : ℝ) ^ 6 := by positivity
  generalize hb_eq : (25 / 4 : ℝ) - a = b at hb0
  have ha_add_b : a + b = 25 / 4 := by linarith only [hb_eq]
  have hbern : (25 / 4 : ℝ) ^ 6 * ((6889 / 400 - a) * (((1 / 3) * a ^ 0 + (-4 / 45) * a ^ 1 + (1 / 105) * a ^ 2 + (-8 / 14175) * a ^ 3 + (2 / 93555) * a ^ 4 + (-8 / 14189175) * a ^ 5) - 1 / 140) - 2 * (1 * a ^ 0 + (-1 / 3) * a ^ 1 + (2 / 45) * a ^ 2 + (-1 / 315) * a ^ 3 + (2 / 14175) * a ^ 4)) =
      ((607793 / 168000)) * a ^ 0 * b ^ 6 +
      ((3595237 / 252000)) * a ^ 1 * b ^ 5 +
      ((9464723 / 403200)) * a ^ 2 * b ^ 4 +
      ((37079363 / 1814400)) * a ^ 3 * b ^ 3 +
      ((9443670773 / 958003200)) * a ^ 4 * b ^ 2 +
      ((1037099048611 / 435891456000)) * a ^ 5 * b ^ 1 +
      ((8719091 / 52416000)) * a ^ 6 * b ^ 0 := by
    rw [← hb_eq]; ring
  have hrhs : 0 < ((607793 / 168000)) * a ^ 0 * b ^ 6 +
      ((3595237 / 252000)) * a ^ 1 * b ^ 5 +
      ((9464723 / 403200)) * a ^ 2 * b ^ 4 +
      ((37079363 / 1814400)) * a ^ 3 * b ^ 3 +
      ((9443670773 / 958003200)) * a ^ 4 * b ^ 2 +
      ((1037099048611 / 435891456000)) * a ^ 5 * b ^ 1 +
      ((8719091 / 52416000)) * a ^ 6 * b ^ 0 := by positivity
  exact pos_of_mul_pos hW6 (hbern ▸ hrhs)

