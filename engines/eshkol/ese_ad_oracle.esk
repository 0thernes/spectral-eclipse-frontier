;; Spectral Eclipse Frontier -- Native Eshkol v1.3.6 Automatic Differentiation Oracle
;; Uses Eshkol's compiler-native exact forward-mode AD primitive `(derivative f x)`
;; and second-order Taylor-tower `(derivative-n f x 2)` (ZERO finite differences)
;; to compute exact return-amplitude derivatives A'(t), A''(t), verify the
;; Conjecture 4.1 7x7 slope condition, and Newton-refine Early State Exclusion
;; roots tau_ESE to machine precision across Theorems 4, 5, 7, and 9.

(define pi-val 3.14159265358979323846)

;; 1. Exact 7x7 ESE chain {0, +-3, +-4, +-5} (Theorem 4 / Conjecture 4.1 converse)
;; Unnormalized odd Hochstadt weights: W_0 = 1/3600 = 7/25200, W_1 = 1/1008 = 25/25200,
;; W_2 = 1/1008 = 25/25200, W_3 = 1/3600 = 7/25200.
;; Normalized return weights: (7/64, 25/64, 25/64, 7/64), satisfying A(pi) = (7-25+25-7)/64 = 0.
(define (amp7-345 t)
  (/ (+ 7.0
        (* 25.0 (cos (* 3.0 t)))
        (* 25.0 (cos (* 4.0 t)))
        (* 7.0  (cos (* 5.0 t))))
     64.0))

;; 2. Exact 8x8 m=1 rupture chain {+-1/2, +-7/2, +-9/2, +-11/2} (Theorem 5)
;; Scaled half-integer weights w_k = 1 / (p_k * prod_{j!=k} |p_k^2 - p_j^2|) for p = (1, 7, 9, 11):
(define w8-1 (/ 1.0 460800.0))
(define w8-2 (/ 1.0 774144.0))
(define w8-3 (/ 1.0 921600.0))
(define w8-4 (/ 1.0 3801600.0))
(define w8-sum (+ w8-1 (+ w8-2 (+ w8-3 w8-4))))

(define (amp8-m1 t)
  (/ (+ (* w8-1 (cos (* 0.5 t)))
        (+ (* w8-2 (cos (* 3.5 t)))
           (+ (* w8-3 (cos (* 4.5 t)))
              (* w8-4 (cos (* 5.5 t))))))
     w8-sum))

;; 3. Exact 11x11 m=6 supercritical rupture chain {0, +-1, +-12, +-13, +-14, +-15} (Theorem 7)
(define w11-0 (/ 1.0 (* 144.0 (* 169.0 (* 196.0 225.0)))))
(define w11-1 (/ 1.0 (* 143.0 (* 168.0 (* 195.0 224.0)))))
(define w11-2 (/ 1.0 (* 144.0 (* 143.0 (* 25.0 (* 52.0 81.0))))))
(define w11-3 (/ 1.0 (* 169.0 (* 168.0 (* 25.0 (* 27.0 56.0))))))
(define w11-4 (/ 1.0 (* 196.0 (* 195.0 (* 52.0 (* 27.0 29.0))))))
(define w11-5 (/ 1.0 (* 225.0 (* 224.0 (* 81.0 (* 56.0 29.0))))))
(define w11-sum (+ w11-0 (+ w11-1 (+ w11-2 (+ w11-3 (+ w11-4 w11-5))))))

(define (amp11-m6 t)
  (/ (+ w11-0
        (+ (* w11-1 (cos t))
           (+ (* w11-2 (cos (* 12.0 t)))
              (+ (* w11-3 (cos (* 13.0 t)))
                 (+ (* w11-4 (cos (* 14.0 t)))
                    (* w11-5 (cos (* 15.0 t))))))))
     w11-sum))

;; 4. Kernel H(w) = (1 - cos(2*sqrt(w))) / (2*w) for Theorem 4 & Theorem 6 AD slope verification
(define (kernel-H w)
  (/ (- 1.0 (cos (* 2.0 (sqrt w)))) (* 2.0 w)))

;; Exact Newton solver using Eshkol's compiler-native `(derivative f x)` (forward-mode AD)
(define (newton-ad f x0 steps)
  (if (= steps 0)
      x0
      (let ((fx (f x0))
            (dfx (derivative f x0)))
        (newton-ad f (- x0 (/ fx dfx)) (- steps 1)))))

(define tau7  (newton-ad amp7-345 0.45 12))
(define tau8  (newton-ad amp8-m1  0.60 12))
(define tau11 (newton-ad amp11-m6 0.20 12))

;; Verify H''(w) > 0 at w = 10.0 (x = 3.162 <= 3.30) and H'''(w) < 0 at w = 16.0 (x = 4.0 <= 4.15)
;; directly via Eshkol compiler-native AD!
(define dH-10  (derivative kernel-H 10.0))
(define d2H-10 (derivative (lambda (w) (derivative kernel-H w)) 10.0))
(define d2H-16 (derivative (lambda (w) (derivative kernel-H w)) 16.0))
(define d3H-16 (derivative (lambda (w) (derivative (lambda (v) (derivative kernel-H v)) w)) 16.0))

(display "[Eshkol AD] 7x7 {0,+-3,+-4,+-5} tau_ESE = ") (display tau7)
(display "  A(tau) = ") (display (amp7-345 tau7))
(display "  A'(tau) = ") (display (derivative amp7-345 tau7)) (newline)

(display "[Eshkol AD] 8x8 m=1 rupture     tau_ESE = ") (display tau8)
(display "  A(tau) = ") (display (amp8-m1 tau8))
(display "  A'(tau) = ") (display (derivative amp8-m1 tau8)) (newline)

(display "[Eshkol AD] 11x11 m=6 rupture   tau_ESE = ") (display tau11)
(display "  A(tau) = ") (display (amp11-m6 tau11))
(display "  A'(tau) = ") (display (derivative amp11-m6 tau11)) (newline)

(display "[Eshkol AD] Kernel H'(10) = ") (display dH-10)
(display "  H''(10) = ") (display d2H-10)
(display "  H''(16) = ") (display d2H-16)
(display "  H'''(16) = ") (display d3H-16) (newline)
